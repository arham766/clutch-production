# ─────────────────────────────────────────────────────────────────────────────
# Clutch — Environment Configuration
# Copy to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# CORE (mandatory — app will not start without these)
# ═══════════════════════════════════════════════════════════════════════════

# Moss (retrieval)
MOSS_API_KEY=
MOSS_BASE_URL=

# TrueFoundry AI Gateway (model routing)
TRUEFOUNDRY_API_KEY=
TRUEFOUNDRY_BASE_URL=

# LiveKit (realtime transport)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Firebase (auth, Firestore DB, Storage)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=path/to/service-account.json

# ═══════════════════════════════════════════════════════════════════════════
# ROLES (optional — have sensible defaults)
# These are ROLE names, never vendor names (HLD 00 §7).
# ═══════════════════════════════════════════════════════════════════════════

# REASON_MODEL=minimax-reasoning
# VISION_MODEL=qwen-vl-plus
# EMBED_MODEL=text-embedding-3-small
# STT_PROVIDER=cartesia
# TTS_PROVIDER=cartesia
# PARSE_PROVIDER=unsiloed

# ═══════════════════════════════════════════════════════════════════════════
# FEATURES (optional — system degrades gracefully without these)
# ═══════════════════════════════════════════════════════════════════════════

# UNSILOED_API_KEY=
